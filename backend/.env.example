# Copy this file to .env. The app works without an OpenAI key in demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# SQLite is easiest for local development. To use Postgres, install psycopg and set a PostgreSQL URL.
DATABASE_URL=sqlite:///./careerpilot.db
FRONTEND_ORIGIN=http://localhost:5173
